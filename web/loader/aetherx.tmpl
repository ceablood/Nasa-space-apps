  var sky = document.getElementById('kzsky'), sg = sky.getContext('2d'), stars = [];
  function rs() { var d = Math.min(devicePixelRatio || 1, 2); sky.width = innerWidth * d; sky.height = innerHeight * d; sg.setTransform(d, 0, 0, d, 0, 0); }
  rs(); addEventListener('resize', rs);
  for (var i = 0; i < 420; i++) stars.push([Math.random(), Math.random(), Math.random() * 1.4 + 0.3, Math.random() * 6.28, Math.random()]);
  // --- gezegenler (NASA haritaları; Venüs: görünür ışıkta özelliksiz bulut örtüsü, prosedürel)
  var ORDER = ['moon', 'mars', 'earth', 'venus', 'jupiter'];
  var SIZE = { moon: 0.055, mars: 0.066, earth: 0.09, venus: 0.084, jupiter: 0.12 };
  var GLOW = { moon: '170,180,210', mars: '255,140,90', earth: '90,170,255', venus: '255,210,140', jupiter: '255,190,140' };
  var planets = [];
  var wrap = document.getElementById('kzplanets');
  function fmt(v) { return String(v).replace('.', ','); }
  ORDER.forEach(function (k, idx) {
    var d = NASA[k];
    var el = document.createElement('div'); el.className = 'kz-p'; el.style.animationDelay = (0.15 * idx) + 's';
    var cv = document.createElement('canvas');
    el.appendChild(cv);
    var b = document.createElement('b'); b.textContent = d.name.toLocaleUpperCase('tr'); el.appendChild(b);
    var s = document.createElement('span');
    s.textContent = fmt(d.g) + ' m/s² · ' + d.diam_km.toLocaleString('tr-TR') + ' km · ' + d.temp_c + ' °C';
    el.appendChild(s);
    wrap.appendChild(el);
    var p = { k: k, cv: cv, g: cv.getContext('2d'), tex: null, tw: 0, th: 0, spin: Math.random(), speed: k === 'jupiter' ? 0.03 : 0.012 };
    planets.push(p);
    if (k !== 'venus') {
      var im = new Image();
      im.onload = function () {
        var c = document.createElement('canvas'); c.width = im.width; c.height = im.height;
        var cg = c.getContext('2d'); cg.drawImage(im, 0, 0);
        p.tex = cg.getImageData(0, 0, c.width, c.height).data; p.tw = c.width; p.th = c.height; p.geo = null;
      };
      im.src = 'nasa/' + k + '.jpg';
    } else {   // Venüs: sarımsı bulut bantları
      var tw = 256, th = 128, a = new Uint8ClampedArray(tw * th * 4);
      for (var y = 0; y < th; y++) for (var x = 0; x < tw; x++) {
        var u = x / tw * 6.2832;   // boylamda periyodik: dikiş yok
        var n = 0.5 + 0.25 * Math.sin(3 * u + Math.sin(y / 7) * 2) + 0.15 * Math.sin(y / 5 + 2 * u) + 0.1 * Math.sin(7 * u + y / 4.3);
        var o = (y * tw + x) * 4; a[o] = 200 + 45 * n; a[o + 1] = 168 + 55 * n; a[o + 2] = 104 + 60 * n; a[o + 3] = 255;
      }
      p.tex = a; p.tw = tw; p.th = th;
    }
  });
  function layout() {
    // hepsi tek sıraya sığsın (tuval = 2,9R) ve en büyüğü ekran yüksekliğinin ~%30'unu geçmesin
    var m = Math.min(innerWidth * 0.74, innerHeight * 0.86);
    planets.forEach(function (p) {
      var R = Math.max(12, Math.round(SIZE[p.k] * m)); if (R === p.R) return;
      p.R = R; var S = R * 2 + Math.round(R * 0.9);
      p.cv.width = S; p.cv.height = S; p.cv.style.width = S + 'px'; p.cv.style.height = S + 'px'; p.geo = null;
    });
  }
  layout(); addEventListener('resize', layout);
  // piksel başına küre: ortografik izdüşüm, eksen eğikliği, Güneş sol üstten, gece tarafı ve kenar kararması
  function build(p) {
    var R = p.R, S = p.cv.width, c = S / 2, idx = [], lat = [], lon = [], li = [], al = [];
    var L = [-0.62, -0.36, 0.7], ln = Math.hypot(L[0], L[1], L[2]); L = [L[0] / ln, L[1] / ln, L[2] / ln];
    var tilt = 0.38;
    for (var y = 0; y < S; y++) for (var x = 0; x < S; x++) {
      var nx = (x + 0.5 - c) / R, ny = (y + 0.5 - c) / R, d2 = nx * nx + ny * ny;
      if (d2 > 1) continue;
      var nz = Math.sqrt(1 - d2);
      var cy = -ny * Math.cos(tilt) + nz * Math.sin(tilt), cz = ny * Math.sin(tilt) + nz * Math.cos(tilt);
      var la = Math.asin(Math.max(-1, Math.min(1, cy))), lo = Math.atan2(nx, cz);
      idx.push(y * S + x);
      lat.push(Math.min(p.th - 1, Math.max(0, Math.floor((0.5 - la / Math.PI) * p.th))));
      lon.push((lo / 6.2832 + 0.5) * p.tw);
      var dot = nx * L[0] + ny * L[1] + nz * L[2];
      var day = Math.max(0, Math.min(1, dot * 2.4 + 0.3));
      li.push((0.035 + 0.965 * day * day) * (0.6 + 0.4 * Math.pow(nz, 0.5)) * 1.12);
      al.push(d2 > 0.97 ? Math.max(0, (1 - d2) / 0.03) * 255 : 255);
    }
    p.geo = { idx: idx, lat: lat, lon: lon, li: li, al: al, img: p.g.createImageData(S, S) };
  }
  function drawPlanet(p, dt) {
    if (!p.tex) return;
    if (!p.geo) build(p);
    p.spin = (p.spin + dt * p.speed) % 1;
    var G = p.geo, out = G.img.data, tex = p.tex, tw = p.tw, sh = p.spin * tw, n = G.idx.length;
    for (var i = 0; i < n; i++) {
      var tx = (G.lon[i] + sh) | 0; if (tx >= tw) tx -= tw;
      var ti = (G.lat[i] * tw + tx) * 4, o = G.idx[i] * 4, L = G.li[i];
      out[o] = tex[ti] * L; out[o + 1] = tex[ti + 1] * L; out[o + 2] = tex[ti + 2] * L; out[o + 3] = G.al[i];
    }
    var S = p.cv.width, c = S / 2, g = p.g;
    g.clearRect(0, 0, S, S);
    var gr = g.createRadialGradient(c, c, p.R * 0.9, c, c, p.R * 1.4);
    gr.addColorStop(0, 'rgba(' + GLOW[p.k] + ',0.32)'); gr.addColorStop(1, 'rgba(' + GLOW[p.k] + ',0)');
    g.fillStyle = gr; g.fillRect(0, 0, S, S);
    // ImageData saydamlığı alttakiyle karışmaz: önce ayrı tuvale, sonra çiz
    if (!p.tmp) { p.tmp = document.createElement('canvas'); }
    if (p.tmp.width !== S) { p.tmp.width = S; p.tmp.height = S; }
    p.tmp.getContext('2d').putImageData(G.img, 0, 0);
    g.drawImage(p.tmp, 0, 0);
  }
  // --- aşamalar ve ilerleme (pygbag'in kendi durum alanlarından okunur)
  var STAGES = ['Sayfa ve NASA görüntüleri', 'Python çalışma ortamı', 'Oyun paketi', 'Hazır'];
  var st = document.getElementById('kzstages');
  st.innerHTML = STAGES.map(function (s) { return '<div>' + s + '</div>'; }).join('');
  var stEls = st.children, stage = 0, shown = 0, ready = false, hiding = false;
  function setStage(i) { stage = Math.max(stage, i); for (var k = 0; k < stEls.length; k++) stEls[k].className = k < stage ? 'done' : (k === stage ? 'run' : ''); }
  setStage(1);
  function hide() { if (hiding) return; hiding = true; kz.classList.add('out'); setTimeout(function () { kz.style.display = 'none'; running = false; }, 900); }
  // dokununca katman hemen kalkmaz: oyun penceresi açılana kadar "başlatılıyor" gösterilir (boş ekran olmasın)
  var starting = 0;
  function start() { if (starting) return; starting = performance.now(); kz.classList.remove('ready'); kz.classList.add('starting'); }
  document.getElementById('kzstart').addEventListener('click', function () { start(); });
  // hazır olunca ya da oyun paketi açılmaya başladıktan sonra dokunmak katmanı kaldırır (dokunuş sesi de açar)
  kz.addEventListener('click', function () { var c = document.getElementById('canvas'); if (ready || (c && c.style.visibility === 'visible' && (performance.now() - t0) > 4000)) start(); });
  var fi = Math.floor(Math.random() * FACTS.length), factEl = document.getElementById('kzfact');
  function fact() {
    var f = FACTS[fi++ % FACTS.length]; factEl.classList.remove('show');
    setTimeout(function () { factEl.innerHTML = ''; factEl.appendChild(document.createTextNode(f[0])); var s = document.createElement('small'); s.textContent = 'Kaynak: ' + f[1]; factEl.appendChild(s); factEl.classList.add('show'); }, 400);
  }
  fact(); setInterval(fact, 6000);
  var umeSince = 0;
  function poll() {
    var t = (performance.now() - t0) / 1000;
    var prog = document.getElementById('progress'), status = document.getElementById('status'), info = document.getElementById('infobox');
    var canvas = document.getElementById('canvas');
    var stxt = status ? status.textContent.trim() : '';
    var real = prog && prog.max > 0 && prog.value > 0 ? prog.value / prog.max : 0;
    var started = canvas && canvas.style.visibility === 'visible';
    if (started) setStage(2);
    var est = started ? 0.55 + 0.4 * (1 - Math.exp(-(t - 2) / 12)) : 0.5 * (1 - Math.exp(-t / 10));
    var want = Math.max(est, real * (started ? 1 : 0.5));
    var it = info ? info.innerText || '' : '';
    if (!starting && /ready|click|touch/i.test(it)) { ready = true; setStage(3); want = 1; kz.classList.add('ready'); }
    if (starting) {
      want = 1;
      if ((canvas && canvas.width > 64) || performance.now() - starting > 25000) hide();
    }
    var mm = window.MM;
    // oyun pencereyi açtı (pygame.display.set_mode tuvali büyütür) ve kullanıcı zaten etkileşmişse katmanı kaldır
    var gameUp = canvas && canvas.width > 64;
    if (gameUp && mm && mm.UME && !ready) { if (!umeSince) umeSince = t; if (t - umeSince > 0.6) { setStage(3); want = 1; hide(); } }
    shown = Math.max(shown, Math.min(want, 1));
    document.getElementById('kzfill').style.width = (shown * 100).toFixed(1) + '%';
    document.getElementById('kzpct').textContent = Math.round(shown * 100) + '%';
    var lbl = starting ? 'Oyun başlatılıyor…' : ready ? 'Hazır' : (/install/i.test(it) ? it : (stxt && !/^Downloading\.\.\.$/i.test(stxt) ? stxt : (started ? 'Oyun paketi açılıyor…' : 'Python ve pygame indiriliyor…')));
    document.getElementById('kzlabel').textContent = lbl;
  }
  setInterval(poll, 250);
  var running = true, last = performance.now();
  function loop(now) {
    if (!running) return;
    var dt = Math.min(0.1, (now - last) / 1000); last = now;
    var w = innerWidth, h = innerHeight, tt = now / 1000;
    sg.clearRect(0, 0, w, h);
    for (var i = 0; i < stars.length; i++) {
      var s = stars[i], a = 0.35 + 0.65 * (0.5 + 0.5 * Math.sin(tt * (0.6 + s[4]) + s[3]));
      sg.fillStyle = s[4] > 0.85 ? 'rgba(255,214,170,' + a + ')' : 'rgba(220,232,255,' + a + ')';
      sg.fillRect(s[0] * w, s[1] * h, s[2], s[2]);
    }
    planets.forEach(function (p) { drawPlanet(p, dt); });
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);
})();
</script>
</body>
</html>
